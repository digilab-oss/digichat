# What we build on. We rebase onto UPSTREAM_SHA (a commit can't move); UPSTREAM is just the
# tag that currently points at it. The sync workflow updates both when it rebases.
UPSTREAM=v11.7.8
UPSTREAM_SHA=d42004bb3046de3ed176938a34b1a70c1c3d9421

# Our patch revision for this UPSTREAM, used in the image tag
# <version>-digilab.<PATCHREV>-<sha7>. Not a build counter; the sha7 already makes each build
# unique. Bump it here by hand only when the built bytes change for the same UPSTREAM, e.g. a
# changed //DIGILAB patch or a Go/Node toolchain bump. Don't bump it for a rebase (UPSTREAM
# changes instead) or for tooling-only edits under .github/ and .digilab/.
PATCHREV=1
