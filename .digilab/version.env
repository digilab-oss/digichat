# The exact upstream we build on. UPSTREAM_SHA is the immutable anchor (tags are
# mutable — upstream could move/delete one); UPSTREAM is the human-readable tag.
# The sync workflow rebases onto UPSTREAM_SHA and re-pins both on each bump.
UPSTREAM=v11.7.6
